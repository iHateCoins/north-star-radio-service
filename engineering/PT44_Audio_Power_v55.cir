R23 O 0 470000
R24 K 0 130
C22 K 0 2.5e-10
BOP T K I={1*(V(N_BPLUS_FILT,K)>0)*Q(V(N_BPLUS_FILT,K))^1.5*OUTP(max(V(T,K),0)/Q(V(N_BPLUS_FILT,K)),V(O,K)/Q(V(N_BPLUS_FILT,K)))}
BOS N_BPLUS_FILT K I={1*(V(N_BPLUS_FILT,K)>0)*Q(V(N_BPLUS_FILT,K))^1.5*OUTS(max(V(T,K),0)/Q(V(N_BPLUS_FILT,K)),V(O,K)/Q(V(N_BPLUS_FILT,K)))}
BOG O K I={0.0007*(V(N_BPLUS_FILT,K)>0)*max(V(O,K),0)^1.5}
R26 N_BPLUS_RECT X 200
L26 X T 5 IC=0
BSPEAKER SPEAKER 0 V={V(X,T)/25}
C18 W G 1e-8 IC=0
C20 P O 1e-8 IC=0
RREF X T 2000
